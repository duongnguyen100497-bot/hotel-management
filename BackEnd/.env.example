# Application
APP_ENV=development
HTTP_ADDR=:8080
SHUTDOWN_TIMEOUT=15s
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
PUBLIC_BASE_URL=http://localhost:8080
HOTEL_TIMEZONE=Asia/Ho_Chi_Minh
UPLOAD_MAX_BYTES=5242880

# PostgreSQL
DATABASE_URL=postgres://hotel:hotel_dev_pass@localhost:5432/hotel_management?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO (S3-compatible object storage)
MINIO_ENABLED=true
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=hotel-media
MINIO_USE_SSL=false
MINIO_PUBLIC_BASE_URL=http://localhost:9000/hotel-media

# Authentication (replace with strong random secrets in non-local environments)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Initial Root Admin Bootstrap (used by `go run ./cmd/bootstrap`)
BOOTSTRAP_ADMIN_EMAIL=admin@hotel.local
BOOTSTRAP_ADMIN_PASSWORD=Admin123456!
BOOTSTRAP_ADMIN_NAME=Root System Administrator

# SePay incoming webhook (demo)
SEPAY_WEBHOOK_SECRET=change-me-sepay-webhook-secret
SEPAY_RECEIVING_ACCOUNT=0000000000

# SMTP (defaults to local Mailpit; switch to Gmail SMTP if desired)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@hotel.local
